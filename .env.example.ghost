# Ghost configuration
# Copy this file to .env and fill in your API keys.

# ────────────────────────────────────────────────────────────────────
# LLM provider — pick one. Ghost defaults to OpenAI-compatible providers
# (no Anthropic dependency). Domestic CN providers recommended for
# automation-heavy workloads.
# ────────────────────────────────────────────────────────────────────

# Optionally pin a provider explicitly. If unset, Ghost picks the first
# provider with a key set below. Valid values:
#   alibaba | zhipu | siliconflow | groq | nvidia | google | openrouter | modelscope | anthropic
# GHOST_PROVIDER=alibaba

# Optionally pin a model. If unset, the provider's default is used.
# GHOST_MODEL=qwen-plus

# 阿里云百炼 (Qwen) — strong tool calling, fast in CN
ALIBABA_API_KEY=
# ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 智谱 GLM — glm-4-flash is free
ZHIPU_API_KEY=

# 硅基流动 SiliconFlow — daily free quota
SILICONFLOW_API_KEY=

# Groq — fastest inference (sub-second), free tier
GROQ_API_KEY=

# NVIDIA NIM — free tier
NVIDIA_API_KEY=

# Google AI Studio (Gemini) — supports vision via OpenAI-compat endpoint
GOOGLE_API_KEY=

# OpenRouter — 200+ models, single key
OPENROUTER_API_KEY=

# 魔搭 ModelScope — 2000 calls/day free
MODELSCOPE_API_KEY=

# ────────────────────────────────────────────────────────────────────
# Anthropic (OPTIONAL, opt-in only)
#
# Why opt-in: calling Anthropic's endpoint subjects every prompt to their
# server-side content/behavior policies, which restrict many automation
# tasks (computer-use, scraping, etc.). Ghost works great without it.
# To use it:
#   1. set GHOST_PROVIDER=anthropic above
#   2. fill in the key below
#   3. pip install anthropic
# ────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ────────────────────────────────────────────────────────────────────
# Approval / safety
#
# Ghost runs in YOLO mode by DEFAULT — same authority as you, no prompts.
# This is the entire point: he is you, you are him. If you want restrictions,
# explicitly opt in below.
# ────────────────────────────────────────────────────────────────────

# YOLO mode: 1 = no approval prompts (DEFAULT), 0 = use GHOST_APPROVAL below
GHOST_YOLO=1

# Only used when GHOST_YOLO=0:
#   interactive — ask before each dangerous tool
#   policy      — match commands/paths against policy.yaml
GHOST_APPROVAL=interactive

# Path to policy file (used when GHOST_APPROVAL=policy)
# GHOST_POLICY_FILE=~/.ghost/policy.yaml

# ────────────────────────────────────────────────────────────────────
# Behavior
# ────────────────────────────────────────────────────────────────────

# Enable/disable streaming output (typewriter effect).
# Set to 0 if piping output to scripts.
GHOST_STREAM=1

GHOST_LOG_LEVEL=INFO

# Vision provider for screen analysis (alibaba / zhipu)
GHOST_VISION=alibaba

# ────────────────────────────────────────────────────────────────────
# Ghost data directory (defaults to ~/.ghost)
# ────────────────────────────────────────────────────────────────────
# GHOST_HOME=

# ────────────────────────────────────────────────────────────────────
# Telegram channel
# Get token from @BotFather, your ID from @userinfobot
# ────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_IDS=
TELEGRAM_CHAT_ID=

# ────────────────────────────────────────────────────────────────────
# Discord channel
# ────────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_IDS=
DISCORD_CHANNEL_ID=
DISCORD_WEBHOOK_URL=

# ────────────────────────────────────────────────────────────────────
# 飞书/Lark
# ────────────────────────────────────────────────────────────────────
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# ────────────────────────────────────────────────────────────────────
# 企业微信
# ────────────────────────────────────────────────────────────────────
WECOM_BOT_ID=
WECOM_SECRET=

# ────────────────────────────────────────────────────────────────────
# 钉钉
# ────────────────────────────────────────────────────────────────────
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_ROBOT_CODE=

# ────────────────────────────────────────────────────────────────────
# Cron job delivery: telegram | discord | (empty = no delivery)
# ────────────────────────────────────────────────────────────────────
GHOST_CRON_NOTIFY=telegram
